.superpowers/
node_modules/
dist/
*.tsbuildinfo
packages/package-manager/bundled-plugins/document-reader/src/runtime/
.agnes-tmp/

# A literal tilde directory: host defaults dataDir to the string "~/.agnes" and nothing
# expands it, so a run without an explicit dataDir writes here. Ignored so it cannot be
# committed again; the defect itself is being fixed in host.
~/
.agnes-scratch/

# Compiled at build time by packages/host/scripts/build-native.mjs (macOS only). Host helpers
# live in its ignored dist/ tree; C sources remain in packages/host/native/.
packages/host/native/macos-process-identity
packages/host/native/macos-live-app-identity

# Subagent worktrees live inside the repository; the fail-closed manager verifies this rule before
# creating one so the parent checkout cannot accidentally stage a nested worktree.
.worktrees/
.codegraph/

# Machine-local IDE settings and temporary Windows test output.
.idea/
/.windows-core-host-check.log
.agnes
.agh
learn/
.DS_Store

# Local assistant configuration and unpublished scratch material.
.claude/
.cursor/
outputs/
spikes/
docs/task-records/

# protein-predictor runtime outputs: live runs and tool tests drop new confidence/PDB
# files here every round. Curated examples are re-included explicitly; everything else
# stays untracked so regression runs don't dirty the tree.
examples/packages/protein-predictor/reports/*
examples/packages/protein-predictor/structures/*
!examples/packages/protein-predictor/reports/P04637.vs-alphafold.json
!examples/packages/protein-predictor/reports/P61626_lysozyme_C_148aa.confidence.json
!examples/packages/protein-predictor/reports/human_lysozyme_P61626_148aa.confidence.json
!examples/packages/protein-predictor/reports/p53_human_P04637_393aa.confidence.json
!examples/packages/protein-predictor/reports/p53_human_P04637_393aa.vs-P04637_alphafold_ref.compare.json
!examples/packages/protein-predictor/structures/LYSC_HUMAN_P61626_148aa.pdb
!examples/packages/protein-predictor/structures/P04637_393aa.pdb
!examples/packages/protein-predictor/structures/P04637_alphafold_ref.pdb
!examples/packages/protein-predictor/structures/P0A7B8_176aa.pdb
!examples/packages/protein-predictor/structures/P61626_148aa.pdb
!examples/packages/protein-predictor/structures/P61626_lysozyme_C_148aa.pdb
!examples/packages/protein-predictor/structures/human_lysozyme_P61626_148aa.pdb
!examples/packages/protein-predictor/structures/p53_human_P04637_393aa.pdb
